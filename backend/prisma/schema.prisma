// THIS IS A PRISMA SCHEMA FILE
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ==========================================
// PARC AUTO & UTILAJE GRELE (VEHICULE)
// ==========================================

model CategorieVehicul {
  id                   String        @id @default(uuid())
  nume                 String        @unique // ex: TEHERAUTÓ, EXCAVATOR, ÎNCĂRCĂTOR
  descriere            String?
  tipMasurareImplicit  String        @default("KM") // KM vs MTH
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  vehicule             Vehicul[]
}

model Vehicul {
  id                     String              @id @default(uuid())
  numarIntern            String              @unique // ex: UTIL-01, CAM-03
  numarInmatriculare     String              @unique // ex: B-101-VLV
  serieSasiu             String?             // VIN / Serie șasiu
  marca                  String
  model                  String
  anFabricatie           Int
  categorieEnum          String              // FK catre CategorieVehicul.nume
  categorie              CategorieVehicul    @relation(fields: [categorieEnum], references: [nume])

  tipMasurare            String              @default("KM") // "KM" | "MTH"
  valoareContorCurent    Float               @default(0)
  valoareContorInitial   Float               @default(0)
  dataInregistrareContor DateTime            @default(now())
  tarifOrarStandard      Float?              @default(0) // Manoperă/Chirie per oră

  stare                  String              @default("ACTIV") // ACTIV, IN_REPARATIE, CASAT

  // Relații modul CMMS
  sarciniMentenanta      SarcinaMentenanta[]
  comenziLucru           ComandaLucru[]
  pozitiiAxe             PozitieAx[]
  anvelope               Anvelopa[]
  istoricPermutari       IstoricPermutareAnvelopa[]
  istoricContor          IstoricContorVehicul[]
  completariLichid       CompletareLichid[]
  configurariUlei        ConfigurareUleiVehicul[]

  profileMentenanta      ProfilMentenantaVehicul[]
  documente              DocumentVehicul[]
  executiiReguli         ExecutieRegulaVehicul[]

  cuplariCapTractor      IstoricCuplare[]    @relation("CapTractorCuplari")
  cuplariSemiremorca     IstoricCuplare[]    @relation("SemiremorcaCuplari")

  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
}

model IstoricCuplare {
  id                 String    @id @default(uuid())
  capTractorId       String
  capTractor         Vehicul   @relation("CapTractorCuplari", fields: [capTractorId], references: [id], onDelete: Cascade)
  semiremorcaId      String
  semiremorca        Vehicul   @relation("SemiremorcaCuplari", fields: [semiremorcaId], references: [id], onDelete: Cascade)

  kmInceputTractor   Float
  kmSfarsitTractor   Float?
  kmParcursiAnsa     Float?

  dataCuplare        DateTime  @default(now())
  dataDecuplare      DateTime?
  esteActiv          Boolean   @default(true)

  @@index([capTractorId, esteActiv])
  @@index([semiremorcaId, esteActiv])
}

model IstoricContorVehicul {
  id               String   @id @default(uuid())
  vehiculId        String
  vehicul          Vehicul  @relation(fields: [vehiculId], references: [id], onDelete: Cascade)
  valoareContor    Float
  dataInregistrare DateTime @default(now())
  sursa            String   @default("MANUAL") // MANUAL | ALIMENTARE | SERVICE | GPS
  operator         String?
  observatii       String?
}

model ConfigurareUleiVehicul {
  id                   String    @id @default(uuid())
  vehiculId            String
  vehicul              Vehicul   @relation(fields: [vehiculId], references: [id], onDelete: Cascade)
  tipLichid            String    // ULEI_MOTOR, ULEI_HIDRAULIC, ULEI_TRANSMISIE, etc.

  intervalKm           Float?
  intervalMth          Float?
  intervalLuni         Float?

  pragAvertizareKm     Float?    @default(1000)
  pragAvertizareMth    Float?    @default(50)
  pragAvertizareLuni   Float?    @default(1)

  ultimulSchimbContor  Float     @default(0)
  ultimulSchimbData    DateTime  @default(now())

  @@unique([vehiculId, tipLichid])
}

// ==========================================
// MENTENANȚĂ PREVENTIVĂ ȘI ESCALADARE
// ==========================================

model ProfilMentenanta {
  id             String                   @id @default(uuid())
  nume           String
  descriere      String?
  categorieEnum  String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  sarcini        SarcinaMentenanta[]
  vehiculeLegate ProfilMentenantaVehicul[]
}

model ProfilMentenantaVehicul {
  id                 String           @id @default(uuid())
  profilMentenantaId String
  profil             ProfilMentenanta @relation(fields: [profilMentenantaId], references: [id], onDelete: Cascade)
  vehiculId          String
  vehicul            Vehicul          @relation(fields: [vehiculId], references: [id], onDelete: Cascade)

  @@unique([profilMentenantaId, vehiculId])
}

model SarcinaMentenanta {
  id                    String               @id @default(uuid())
  nume                  String
  descriere             String?
  tipSarcina            String               // "INSPECTIE_MANOPERA" | "SCHIMB_PIESA"
  tipMasurare           String               // "KM" | "MTH"
  intervalRulaj         Float                
  ultimulRulajExecutie  Float                @default(0)

  profilId              String?
  profil                ProfilMentenanta?    @relation(fields: [profilId], references: [id], onDelete: SetNull)

  vehiculId             String?
  vehicul               Vehicul?             @relation(fields: [vehiculId], references: [id], onDelete: Cascade)

  sarcinSuperioaraId    String?
  sarcinSuperioara      SarcinaMentenanta?   @relation("LogicaIerarhica", fields: [sarcinSuperioaraId], references: [id], onDelete: SetNull)
  sarciniSubordonate    SarcinaMentenanta[]  @relation("LogicaIerarhica")

  elementeComanda       ElementComandaLucru[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

// ==========================================
// COMENZI DE LUCRU ȘI COSTURI (FIȘĂ TEHNICĂ)
// ==========================================

model ComandaLucru {
  id                     String              @id @default(uuid())
  numarComanda           String              @unique
  vehiculId              String
  vehicul                Vehicul             @relation(fields: [vehiculId], references: [id], onDelete: Cascade)
  dataDeschidere         DateTime            @default(now())
  dataFinalizare         DateTime?
  stare                  String              @default("IN_LUCRU") // "IN_LUCRU" | "FINALIZAT" | "ANULAT"
  mecanicResponsabil     String
  observatii             String?
  valoareContorLaExecutie Float

  elementeComanda        ElementComandaLucru[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
}

model ElementComandaLucru {
  id                   String              @id @default(uuid())
  comandaLucruId       String
  comandaLucru         ComandaLucru        @relation(fields: [comandaLucruId], references: [id], onDelete: Cascade)
  sarcinaMentenantaId  String?
  sarcinaMentenanta    SarcinaMentenanta?  @relation(fields: [sarcinaMentenantaId], references: [id], onDelete: SetNull)
  
  pilonCost            String              // "PIESA_STOC" | "PIESA_DEZMEMBRATA" | "PIESA_DIRECTA" | "MANOPERA_INTERNA" | "PRESTATIE_EXTERNA"
  descriere            String
  cantitate            Float               @default(1)
  pretUnitar           Float               @default(0)
  costTotal            Float               @default(0)
  provenienta          String?             // ex: "Dezmembrări Parcul Propriu", "Stoc Intern", "Furnizor X"

  articolStocId        String?
  articolStoc          ArticolStoc?        @relation(fields: [articolStocId], references: [id], onDelete: SetNull)

  serieUnicaPiesa      String?
  furnizor             String?
  numarFactura         String?

  createdAt            DateTime            @default(now())
}

model Mecanic {
  id        String   @id @default(uuid())
  nume      String   @unique
  functie   String?  @default("Mecanic Atelier")
  telefon   String?
  createdAt DateTime @default(now())
}

model ComponentaSerializata {
  id                 String       @id @default(uuid())
  articolStocId      String
  articolStoc        ArticolStoc  @relation(fields: [articolStocId], references: [id], onDelete: Cascade)
  serieUnica         String       @unique
  dataAchizitie      DateTime     @default(now())
  luniGarantie       Int?
  kilometriGarantie  Float?
  oreGarantie        Float?
  stare              String       @default("IN_STOC") // IN_STOC, MONTAT, DEFECT, CASAT
  vehiculId          String?
  pozitieMontaj      String?
  createdAt          DateTime     @default(now())
}

model CompletareLichid {
  id                  String      @id @default(uuid())
  vehiculId           String
  vehicul             Vehicul     @relation(fields: [vehiculId], references: [id], onDelete: Cascade)
  tipLichid           String      // ULEI_MOTOR, ULEI_HIDRAULIC, etc.
  tipOperatiune       String      @default("COMPLETARE_ULEI") // COMPLETARE_ULEI vs SCHIMB_ULEI
  marcaUlei           String?     
  cantitateLitri      Float
  pretPerLitru        Float       @default(0)
  costTotal           Float       @default(0)
  valoareContor       Float
  dataCompletare      DateTime    @default(now())
  mecanic             String
  observatii          String?
  alertaScurgereGenerata Boolean   @default(false)
  stareAlerta         String      @default("NOUA") // NOUA, REZOLVATA
  solutieRezolvare    String?
  dataRezolvare       DateTime?
}

// ==========================================
// GESTIONARE ANVELOPE ȘI HARTA AXELOR
// ==========================================

model Anvelopa {
  id                   String              @id @default(uuid())
  codDot               String
  serieAnvelopa        String              @default("SN-UNKNOWN")
  marca                String
  model                String
  dimensiune           String
  adancimeInitialaMm   Float
  adancimeCurentaMm    Float
  pretAchizitie        Float
  stare                String              @default("IN_STOC") // "IN_STOC" | "MONTATA" | "CASATA" | "RESAPATA"

  vehiculId            String?
  vehicul              Vehicul?            @relation(fields: [vehiculId], references: [id], onDelete: SetNull)

  pozitieAxId          String?             @unique
  pozitieAx            PozitieAx?          @relation(fields: [pozitieAxId], references: [id], onDelete: SetNull)

  depozitId            String?
  depozit              Depozit?            @relation(fields: [depozitId], references: [id], onDelete: SetNull)

  kilometrajMontare    Float?              @default(0)
  oreMontare           Float?              @default(0)
  rulajTotalKm         Float               @default(0)
  costResapareTotal    Float               @default(0)

  masuratori           MasurareUzuraAnvelopa[]
  istoricPermutari     IstoricPermutareAnvelopa[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model PozitieAx {
  id                String            @id @default(uuid())
  vehiculId         String
  vehicul           Vehicul           @relation(fields: [vehiculId], references: [id], onDelete: Cascade)
  codPozitie        String
  numarAx           Int
  descrierePozitie  String
  
  anvelopa          Anvelopa?

  @@unique([vehiculId, codPozitie])
}

model MasurareUzuraAnvelopa {
  id                 String     @id @default(uuid())
  anvelopaId         String
  anvelopa           Anvelopa   @relation(fields: [anvelopaId], references: [id], onDelete: Cascade)
  dataMasurare       DateTime   @default(now())
  valoareContor      Float
  adancimeProfilMm   Float
  rataUzuraPer10k    Float?
  kmRamasiEstimati   Float?
  tehnician          String
}

model IstoricPermutareAnvelopa {
  id                String   @id @default(uuid())
  anvelopaId        String
  anvelopa          Anvelopa @relation(fields: [anvelopaId], references: [id], onDelete: Cascade)
  vehiculId         String
  vehicul           Vehicul  @relation(fields: [vehiculId], references: [id], onDelete: Cascade)
  pozitieSursaCod   String   // ex: "1-SS" sau "STOC"
  pozitieDestCod    String   // ex: "2-DS" sau "CASAT"
  valoareContor     Float    // Odometru la momentul mutării (KM sau MTH)
  dataPermutare     DateTime @default(now())
  operator          String?
  observatii        String?
}

// ==========================================
// DEPOZITE, TRANSFERURI ȘI CATEGORII DE STOC
// ==========================================

model Depozit {
  id          String        @id @default(uuid())
  nume        String        @unique 
  adresa      String?
  responsabil String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  articoleStoc ArticolStoc[]
  intrariStoc  IntrareStoc[]
  anvelope     Anvelopa[]
  
  transferuriSursa      TransferStoc[] @relation("TransferSursa")
  transferuriDestinatie TransferStoc[] @relation("TransferDestinatie")
}

model CategorieStoc {
  id                 String             @id @default(uuid())
  nume               String             @unique
  descriere          String?
  stocMinimImplicit  Float              @default(5) 
  subcategorii       SubcategorieStoc[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model SubcategorieStoc {
  id              String         @id @default(uuid())
  nume            String
  descriere       String?
  categorieStocId String?
  categorieStoc   CategorieStoc? @relation(fields: [categorieStocId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ArticolStoc {
  id                 String                @id @default(uuid())
  codArticol         String                
  denumire           String
  categorie          String
  subcategorie       String?
  marcaUlei          String?
  stocCurent         Float                 @default(0)
  stocMinim          Float                 @default(0)
  pretUnitar         Float                 @default(0)
  unitateMasura      String                @default("buc")
  esteSerializat     Boolean               @default(false)

  depozitId          String?
  depozit            Depozit?              @relation(fields: [depozitId], references: [id], onDelete: SetNull)

  elementeComanda    ElementComandaLucru[]
  componenteSerializate ComponentaSerializata[]
  intrariStoc        IntrareStoc[]
  transferuriStoc    TransferStoc[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([codArticol, depozitId])
}

model TransferStoc {
  id                   String      @id @default(uuid())
  articolStocId        String
  articolStoc          ArticolStoc @relation(fields: [articolStocId], references: [id], onDelete: Cascade)
  depozitSursaId       String
  depozitSursa         Depozit     @relation("TransferSursa", fields: [depozitSursaId], references: [id], onDelete: Cascade)
  depozitDestinatieId  String
  depozitDestinatie    Depozit     @relation("TransferDestinatie", fields: [depozitDestinatieId], references: [id], onDelete: Cascade)
  cantitateTransferata Float
  operator             String?
  observatii           String?
  dataTransfer         DateTime    @default(now())
}

model IntrareStoc {
  id                 String       @id @default(uuid())
  articolStocId      String
  articolStoc        ArticolStoc  @relation(fields: [articolStocId], references: [id], onDelete: Cascade)

  depozitId          String?
  depozit            Depozit?     @relation(fields: [depozitId], references: [id], onDelete: SetNull)
  tipLichid          String?
  marcaUlei          String?
  furnizor           String
  numarFactura       String
  dataFactura        DateTime     @default(now())
  cantitateIntrata   Float
  pretUnitar         Float
  pretTotal          Float
  observatii         String?
  createdAt          DateTime     @default(now())
}

// ==========================================
// REGULI ALERTE, DOCUMENTE & LICENȚE FIRMĂ
// ==========================================

model DocumentVehicul {
  id                    String   @id @default(uuid())
  vehiculId             String
  vehicul               Vehicul  @relation(fields: [vehiculId], references: [id], onDelete: Cascade)
  tipDocument           String   // "ITP" | "RCA" | "ROVINIETA" | "COPIE_CONFORMA" | "VERIFICARE_TAHOGRAF"
  dataExpirare          DateTime
  zileAvertizareInainte Int      @default(30)
  serieDocument         String?
  emitent               String?
  observatii            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([vehiculId, tipDocument])
}

model RegulaAlertaMentenanta {
  id                 String                  @id @default(uuid())
  denumireOperatiune String                  // ex: "Schimb ulei motor", "Suflare filtru aer"
  categorieUtilaj    String                  @default("TOATE") // "TOATE" sau nume categorie
  tipTrigger         String                  // "KM" | "MTH" | "ZILE"
  valoareMaxima      Float                   // ex: 30000 KM, 1000 mTH, 45 Zile
  avertizareInainte  Float                   // ex: 2000 KM, 100 mTH, 5 Zile
  stare              String                  @default("ACTIV")

  executiiVehicule   ExecutieRegulaVehicul[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
}

model AlertaPersonalizata {
  id                    String   @id @default(uuid())
  titlu                 String   // ex: "Licență Firmă Transport", "Atestat Șofer"
  categorie             String   @default("LICENTA_FIRMA") // "LICENTA_FIRMA" | "ATESTAT_SOFER" | "CUSTOM"
  dataExpirare          DateTime
  zileAvertizareInainte Int      @default(30)
  responsabil           String?
  observatii            String?
  stare                 String   @default("ACTIV")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ExecutieRegulaVehicul {
  id                   String                 @id @default(uuid())
  vehiculId            String
  vehicul              Vehicul                @relation(fields: [vehiculId], references: [id], onDelete: Cascade)
  regulaAlertaId       String
  regulaAlerta         RegulaAlertaMentenanta @relation(fields: [regulaAlertaId], references: [id], onDelete: Cascade)

  ultimulSchimbContor  Float                  @default(0)
  ultimulSchimbData    DateTime               @default(now())
  observatii           String?
  updatedAt            DateTime               @updatedAt

  @@unique([vehiculId, regulaAlertaId])
}

// ==========================================
// MODUL ANAF RO E-FACTURA HIBRID (UBL 2.1)
// ==========================================

model EFacturaConfig {
  id                    String    @id @default("default")
  cifFirma              String    @default("RO12345678")
  clientId              String?
  clientSecret          String?
  redirectUri           String?
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  ultimulSyncSucces     DateTime?
  stareCronAuto         Boolean   @default(true)
  intervalZileSyncAuto  Int       @default(15)
  updatedAt             DateTime  @updatedAt
}

model EFacturaFactura {
  id                String         @id @default(uuid())
  idDescarcare      String         @unique // Cheie unică ANAF (Deduplicare)
  numarInregistrare String?
  cifVanzator       String
  numeVanzator      String
  cifCumparator     String
  numarFactura      String
  dataFactura       DateTime
  dataMesaj         DateTime
  valoareTotala     Float
  moneda            String         @default("RON")
  tipFactura        String         @default("FACTURA") // FACTURA | STORNO
  stare             String         @default("NEPROCESAT") // NEPROCESAT | IMPORTAT_PARȚIAL | IMPORTAT_TOTAL | ELIMINAT
  xmlRawContent     String?        // UBL 2.1 XML stocat local
  articole          EFacturaItem[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model EFacturaItem {
  id                 String          @id @default(uuid())
  facturaId          String
  factura            EFacturaFactura @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  numarLinie         Int
  descrierePiesa     String
  codArticolFurnizor String?
  cantitate          Float
  unitateMasura      String          @default("buc")
  pretUnitar         Float
  valoareFaraTVA     Float
  valoareTVA         Float
  cotaTVA            Float           @default(19)
  stare              String          @default("NEPROCESAT") // NEPROCESAT | IMPORTAT | ELIMINAT
  articolStocId      String?         // Relație cu ArticolStoc creat/actualizat
  createdAt          DateTime        @default(now())
}

// ==========================================
// UTILIZATORI, ROLURI (RBAC) & JURNAL AUDIT
// ==========================================

model User {
  id        String     @id @default(uuid())
  nume      String
  username  String     @unique
  email     String?
  parola    String
  rol       String     @default("OPERATOR") // "ADMIN" | "OPERATOR" | "VIEWER"
  functie   String?    @default("Operator Sistem")
  telefon   String?
  activ     Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  auditLogs AuditLog[]
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail   String?
  userNume    String?
  userRol     String?
  actiune     String   // ex: "CREARE", "MODIFICARE", "STERGERE", "REZOLVARE_ALERTA", "LOGIN"
  modul       String   // ex: "VEHICULE", "MENTENANTA", "ALERTE", "SETARI", "STOCURI", "ANVELOPE", "UTILIZATORI", "EFACTURA"
  entitateTip String?  // ex: "Vehicul", "Mecanic", "Alerta", "ComandaLucru", "Depozit", "User"
  entitateId  String?
  detalii     String?  // Text sau JSON descriind modificarea
  ipAdresa    String?
  createdAt   DateTime @default(now())
}
