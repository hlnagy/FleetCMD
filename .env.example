# ==========================================
# FleetCMD - Környezeti Változók Minta (.env.example)
# ==========================================
# Másold le ezt a fájlt .env néven és állíts be egyedi, biztonságos jelszavakat!
# cp .env.example .env

# PostgreSQL Adatbázis Beállítások
POSTGRES_DB=cmms_flota
POSTGRES_USER=fleet_app_user
POSTGRES_PASSWORD=your_secure_random_password_here
POSTGRES_PORT=5432

# Adatbázis kapcsolati karakterlánc (Connection String)
DATABASE_URL=postgresql://fleet_app_user:your_secure_random_password_here@127.0.0.1:5432/cmms_flota?schema=public

# Alkalmazás Környezet (development | production)
NODE_ENV=development

# Külső Cron / Webhook titkos kulcs (cron-job.org azonosításhoz)
CRON_SECRET=your_secret_cron_key_here

# Robi AI Flottaasszisztens - Google Gemini API Kulcs (Ingyenes: https://aistudio.google.com/app/apikey)
# Ha üresen hagyod, Robi automatikusan a beépített offline motorral válaszol valós adatok alapján!
GEMINI_API_KEY=your_gemini_api_key_here

